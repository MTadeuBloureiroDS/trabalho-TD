// Evento de Colisão entre obj_Bala e obj_InimigoPAI (este é o inimigo)

// --- 1. Aplica o pico do efeito de juice ---

// Aumenta a escala do inimigo (por exemplo, 20% a mais)
image_xscale = escala_base_x * 1.2;
image_yscale = escala_base_y * 1.2;


// --- 2. Lógica de Dano e Destruição ---
image_blend=c_gray
